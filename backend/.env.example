# Server
PORT=3100
NODE_ENV=development

# Database — dùng chung noxh-postgres (host:55432 / trong Docker: noxh-postgres:5432)
# Tạo DB lần đầu: ./scripts/init-shared-db.sh (cần NOXH infra đang chạy)
DATABASE_URL=postgresql://hshn_user:hshn_pass@localhost:55432/haisanhanoi
DB_HOST=localhost
DB_PORT=55432
DB_NAME=haisanhanoi
DB_USER=hshn_user
DB_PASS=hshn_pass

# JWT
JWT_SECRET=hshn-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Đơn khó nhận ship — sau N phút confirm mà chưa có tài xế nhận thì chuyển trạng thái hard_to_ship
HARD_SHIP_TIMEOUT_MIN=10

# Redis — dùng chung noxh-redis (host:56379), DB index 1 tránh conflict với NOXH (index 0)
REDIS_URL=redis://localhost:56379/1

# Cloudflare R2 — 3 bucket riêng: media (ảnh+video), documents (tài liệu), backups (sao lưu)
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public URL: https://pub-<HASH>.r2.dev hoặc domain tùy chỉnh
# Tạo bucket trong Cloudflare dashboard: hsb-media, hsb-documents, hsb-backups
R2_ENABLED=false
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=hsb-media
R2_DOCUMENTS_BUCKET=hsb-documents
R2_BACKUPS_BUCKET=hsb-backups
R2_PUBLIC_URL=

# Backup tự động (chạy trong API, 1 lần/ngày theo giờ UTC)
BACKUP_ENABLED=false
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=30

# CORS
CORS_ORIGIN=*

# Shipping Carriers
GHN_ENABLED=false
GHN_API_URL=https://online-gateway.ghn.vn/shipping
GHN_TOKEN=
GHTK_ENABLED=false
GHTK_API_URL=https://services.ghtk.vn
GHTK_TOKEN=
VIETTEL_ENABLED=false
VIETTEL_API_URL=https://partner.viettelpost.vn/v2
VIETTEL_TOKEN=

# AhaMove
AHAMOVE_ENABLED=false
AHAMOVE_API_URL=https://partner-api.ahamove.com
AHAMOVE_TOKEN=
AHAMOVE_MOBILE=0936141757
AHAMOVE_SHOP_NAME=MEH Seafood
AHAMOVE_SHOP_PHONE=0936141757
AHAMOVE_SHOP_ADDRESS=47 ngõ 16 Phan Văn Trường, Cầu Giấy, Hà Nội
AHAMOVE_SHOP_LAT=21.0324
AHAMOVE_SHOP_LNG=105.7975

# GrabExpress
GRAB_ENABLED=false
GRAB_API_URL=https://api.grab.com
GRAB_TOKEN=

# Bee (BeDelivery)
BEE_ENABLED=false
BEE_API_URL=https://api.be.com.vn
BEE_TOKEN=
