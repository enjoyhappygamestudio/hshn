# API cho app Expo. Bỏ trống / xóa file này để dùng production (apiapp.haisanbay.com).
# Chấp nhận cả dạng có hoặc không có hậu tố /api.
#
# Production VPS:
# EXPO_PUBLIC_API_URL=https://apiapp.haisanbay.com/api
#
# Backend local qua Cloudflare quick tunnel (URL đổi mỗi lần chạy lại cloudflared):
# EXPO_PUBLIC_API_URL=https://<subdomain>.trycloudflare.com/api

EXPO_PUBLIC_API_URL=https://apiapp.haisanbay.com/api
